APP_NAME="Zapateria Angelita"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.zapateriangelita.com
ASSET_URL=
LOG_LEVEL=error

FRONTEND_URL=https://zapateriangelita.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=zapateriangelita.com,www.zapateriangelita.com,api.zapateriangelita.com
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Zapateria Angelita"
MAIL_EHLO_DOMAIN=

GOOGLE_CLIENT_ID=

OPENPAY_MERCHANT_ID=
OPENPAY_PUBLIC_KEY=
OPENPAY_PRIVATE_KEY=
OPENPAY_CERTIFICATION_MODE=false
OPENPAY_SANDBOX=false
OPENPAY_CURRENCY=MXN
OPENPAY_REDIRECT_URL=https://zapateriangelita.com/checkout

# Spring Boot Payment Service (activar solo después de desplegar y validar el microservicio)
PAYMENT_SERVICE_ENABLED=false
PAYMENT_SERVICE_URL=http://127.0.0.1:8081
PAYMENT_SERVICE_SHARED_SECRET=
PAYMENT_SERVICE_TIMEOUT=20
PAYMENT_SERVICE_CALLBACK_TTL=300

FILESYSTEM_DISK=local
MEDIA_ROOT=/home/USUARIO_CPANEL/angelita_media
MEDIA_URL_PREFIX=/api/media
